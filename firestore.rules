rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper to validate non-empty string with maximum length
    function isNonEmptyString(val, maxLen) {
      return val is string && val.size() > 0 && val.size() <= maxLen;
    }

    // Branch Kiosks
    match /kiosks/{kioskId} {
      allow read: if true;
      allow write: if request.resource.data.nama is string && request.resource.data.nama.size() <= 100;
    }

    // Branch Invitations for Employee Self-Registration
    match /invitations/{invitationId} {
      allow read: if true;
      allow write: if request.resource.data.code is string && request.resource.data.code.size() <= 50;
    }

    // Employees Directory
    match /employees/{employeeId} {
      allow read: if true;
      allow write: if request.resource.data.nama is string && request.resource.data.nama.size() <= 150;
    }

    // Attendance Records
    match /attendance/{recordId} {
      allow read: if true;
      allow create: if request.resource.data.employeeId is string && request.resource.data.timestamp is string;
      allow update, delete: if true;
    }

    // Work Shifts
    match /shifts/{shiftId} {
      allow read: if true;
      allow write: if true;
    }

    // System and Owner Config
    match /systemConfig/{configId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
